# Copy this file to .env and fill values locally. Never commit secrets.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Leave blank to keep every notice as an UNSENT local draft.
# Prefer a Gmail App Password, not your normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOWLIST=
